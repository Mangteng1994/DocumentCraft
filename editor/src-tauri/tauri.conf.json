{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocumentCraft",
  "version": "0.3.0",
  "identifier": "app.documentcraft.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocumentCraft",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBNzQ0NUZGNEQ2N0Y5MkEKUldRcStXZE4vMFYwU3VXTVJmWFFYUlllRnN0N2RtU3JPV05EcUVsTjArNkxia05FZEMvZmdiVHMK",
      "endpoints": ["https://github.com/Mangteng1994/DocumentCraft/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
